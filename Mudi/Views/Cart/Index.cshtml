@model List<Product>
@using Mudi_Utility
@{ ViewData["Title"] = "Shopping cart"; }
<div class="page-heading"><div><h1>Your cart</h1><p>Review your items before placing your order.</p></div><a class="btn btn-secondary" asp-controller="Home" asp-action="Index">Continue shopping</a></div>
@if (Model.Count > 0)
{
<form method="post"><div asp-validation-summary="All" class="text-danger"></div><div class="checkout-layout"><div><div class="basket-list">
@for (var i = 0; i < Model.Count; i++) { <input type="hidden" asp-for="@Model[i].Id" /><article class="basket-row"><img src="@WC.ImagePath@Model[i].Image" alt="@Model[i].Name" /><div><h2><a asp-controller="Home" asp-action="Details" asp-route-id="@Model[i].Id">@Model[i].Name</a></h2><p>৳ @Model[i].Price.ToString("N2") / @Model[i].Unit</p></div><div class="basket-quantity"><label asp-for="@Model[i].TempQty">Quantity</label><input asp-for="@Model[i].TempQty" type="number" min="1" max="@Math.Min(100, Model[i].Stock)" class="form-control" /><span asp-validation-for="@Model[i].TempQty" class="text-danger"></span></div><div class="basket-price"><strong>৳ @((Model[i].Price * Model[i].TempQty).ToString("N2"))</strong><br /><a asp-action="Remove" asp-route-id="@Model[i].Id" class="basket-remove" aria-label="Remove @Model[i].Name">Remove</a></div></article> }
</div><div class="form-actions"><button type="submit" asp-action="UpdateCart" formmethod="post" name="Update" value="Update Cart" class="btn btn-secondary">Update cart</button><a asp-action="Clear" class="btn btn-outline-danger">Clear cart</a></div></div><aside class="summary-panel"><h2>Order summary</h2><p class="text-muted">@Model.Count @(Model.Count == 1 ? "product" : "products") in your cart</p><div class="summary-total"><span>Total (BDT)</span><span class="money">৳ @Model.Sum(p => p.Price * p.TempQty).ToString("N2")</span></div><button type="submit" class="btn btn-primary">Continue to checkout <i class="fas fa-arrow-right" aria-hidden="true"></i></button><p class="field-hint">Changed a quantity? Update your cart to refresh the total.</p></aside></div></form>
}
else { <div class="empty-state"><i class="fas fa-shopping-basket" aria-hidden="true"></i><h2>Your cart is empty</h2><p>Browse the shop and add something from your list.</p><a asp-controller="Home" asp-action="Index" class="btn btn-primary">Browse products</a></div> }
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
