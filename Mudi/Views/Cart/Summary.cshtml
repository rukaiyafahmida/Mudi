@model Mudi_Models.ViewModels.ProductUserVM
@{ ViewData["Title"] = "Checkout"; }
<a class="back-link" asp-action="Index"><i class="fas fa-arrow-left" aria-hidden="true"></i>Back to cart</a><div class="page-heading"><div><h1>Checkout</h1><p>Confirm your delivery details and review your order.</p></div></div>
<form method="post"><div asp-validation-summary="All" class="text-danger"></div><div class="checkout-layout"><section class="panel"><h2>Delivery details</h2><div class="field-grid">
<div class="field"><label asp-for="ApplicationUser.FullName">Full name</label><input asp-for="ApplicationUser.FullName" type="text" autocomplete="name" class="form-control" required /><span asp-validation-for="ApplicationUser.FullName" class="text-danger"></span></div>
<div class="field"><label asp-for="ApplicationUser.PhoneNumber">Phone number</label><input asp-for="ApplicationUser.PhoneNumber" type="tel" autocomplete="tel" class="form-control" required /><span asp-validation-for="ApplicationUser.PhoneNumber" class="text-danger"></span></div>
<div class="field"><label asp-for="ApplicationUser.Email">Email address</label><input asp-for="ApplicationUser.Email" type="email" autocomplete="email" class="form-control" required /><span asp-validation-for="ApplicationUser.Email" class="text-danger"></span></div>
<div class="field"><label asp-for="ApplicationUser.StreetAddress">Street address</label><input asp-for="ApplicationUser.StreetAddress" type="text" autocomplete="street-address" class="form-control" required /><span asp-validation-for="ApplicationUser.StreetAddress" class="text-danger"></span></div>
<div class="field"><label asp-for="ApplicationUser.City">City</label><input asp-for="ApplicationUser.City" type="text" autocomplete="address-level2" class="form-control" required /><span asp-validation-for="ApplicationUser.City" class="text-danger"></span></div>
<div class="field"><label asp-for="ApplicationUser.PostalCode">Postal code</label><input asp-for="ApplicationUser.PostalCode" type="text" autocomplete="postal-code" class="form-control" required /><span asp-validation-for="ApplicationUser.PostalCode" class="text-danger"></span></div>

</div></section><aside class="summary-panel"><h2>Your order</h2>
@for (var i = 0; i < Model.ProductList.Count; i++) { <input type="hidden" asp-for="ProductList[i].Id" /><input type="hidden" asp-for="ProductList[i].Name" /><input type="hidden" asp-for="ProductList[i].Price" /><input type="hidden" asp-for="ProductList[i].TempQty" /><div class="summary-item"><div><strong>@Model.ProductList[i].Name</strong><small>Quantity: @Model.ProductList[i].TempQty</small></div><span class="money">৳ @((Model.ProductList[i].Price * Model.ProductList[i].TempQty).ToString("N2"))</span></div> }
<div class="summary-total"><span>Total (BDT)</span><span class="money">৳ @Model.ProductList.Sum(p => p.Price * p.TempQty).ToString("N2")</span></div><button type="submit" class="btn btn-primary" id="submit-button">Place order <i class="fas fa-arrow-right" aria-hidden="true"></i></button></aside></div></form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
