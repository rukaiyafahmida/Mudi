@model Mudi_Models.OrderHeader
@{ ViewData["Title"] = "Order placed"; }
<div class="confirmation"><div class="confirmation-mark"><i class="fas fa-check" aria-hidden="true"></i></div><h1>Your order is placed.</h1><p class="page-intro">Dear @Model.FullName, your order has been placed. You can follow its status in your orders.</p><div class="panel"><div class="receipt-details"><div><h2>Order #@Model.Id</h2><p>@Model.OrderDate.ToString("dd MMM yyyy")</p><span class="status-badge">@Model.OrderStatus</span></div><div><h2>Delivery address</h2><p>@Model.StreetAddress</p><p>@Model.City, @Model.PostalCode</p></div></div><div class="summary-total"><span>Total (BDT)</span><span class="money">৳ @Model.FinalOrderTotal.ToString("N2")</span></div></div><div class="form-actions"><a asp-controller="Order" asp-action="IndexUser" class="btn btn-primary">View your orders</a><a asp-controller="Home" asp-action="Index" class="btn btn-secondary">Back to shop</a></div></div>
