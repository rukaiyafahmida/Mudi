@model Mudi_Models.Product
@{ ViewData["Title"] = "Delete product"; }
<a class="back-link" asp-action="Index"><i class="fas fa-arrow-left" aria-hidden="true"></i>Back to products</a><div class="page-heading"><div><h1>Delete product</h1><p>Products linked to existing orders cannot be deleted.</p></div></div><form method="post"><input asp-for="Id" type="hidden" /><div asp-validation-summary="All" class="text-danger"></div><div class="product-detail"><div class="detail-art"><img src="@Mudi_Utility.WC.ImagePath@Model.Image" alt="@Model.Name" /></div><div class="detail-body"><h2>@Model.Name</h2><span class="badge">@Model.Category.Name</span><div class="price detail-price">৳ @Model.Price.ToString("N2") <small>/ @Model.Unit</small></div><p class="rich-copy">@Model.ShortDescription</p><div class="rich-copy">@Html.Raw(Model.Description)</div><div class="form-actions"><button type="submit" class="btn btn-danger">Delete product</button><a asp-action="Index" class="btn btn-secondary">Cancel</a></div></div></div></form>
