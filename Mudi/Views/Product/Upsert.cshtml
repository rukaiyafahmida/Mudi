@model Mudi_Models.ViewModels.ProductVM
@{ var editing = Model.Product.Id != 0; ViewData["Title"] = editing ? "Edit product" : "Create product"; }
<a class="back-link" asp-action="Index"><i class="fas fa-arrow-left" aria-hidden="true"></i>Back to products</a><div class="page-heading"><div><h1>@ViewData["Title"]</h1><p>Everything your customers need to choose this product.</p></div></div>
<form method="post" enctype="multipart/form-data"><input asp-for="Product.Id" type="hidden" /><div asp-validation-summary="All" class="text-danger"></div><div class="editor-layout"><section class="panel"><h2>Product details</h2><div class="field-grid">
<div class="field full"><label asp-for="Product.Name">Product name</label><input asp-for="Product.Name" class="form-control" /><span asp-validation-for="Product.Name" class="text-danger"></span></div>
<div class="field "><label asp-for="Product.Price">Price (BDT)</label><input asp-for="Product.Price" class="form-control" /><span asp-validation-for="Product.Price" class="text-danger"></span></div>
<div class="field "><label asp-for="Product.Unit">Selling unit</label><input asp-for="Product.Unit" class="form-control" /><span asp-validation-for="Product.Unit" class="text-danger"></span></div>
<div class="field "><label asp-for="Product.Stock">Available stock</label><input asp-for="Product.Stock" class="form-control" /><span asp-validation-for="Product.Stock" class="text-danger"></span></div>

<div class="field"><label asp-for="Product.CategoryId">Category</label><select asp-for="Product.CategoryId" asp-items="Model.CategorySelectList" class="form-control"><option value="">Choose a category</option></select><span asp-validation-for="Product.CategoryId" class="text-danger"></span></div>
<div class="field full"><label asp-for="Product.ShortDescription">Short description</label><input asp-for="Product.ShortDescription" class="form-control" /><span asp-validation-for="Product.ShortDescription" class="text-danger"></span></div><div class="field full"><label asp-for="Product.Description">Full description</label><textarea asp-for="Product.Description" class="form-control summernote"></textarea><span asp-validation-for="Product.Description" class="text-danger"></span></div></div></section><aside class="panel image-panel"><h2>Product image</h2><img id="product-preview" class="image-preview" src="@(editing ? Mudi_Utility.WC.ImagePath + Model.Product.Image : null)" alt="Product image preview" hidden="@(!editing ? "hidden" : null)" />@if (!editing) { <div id="image-placeholder" class="empty-state"><i class="far fa-image" aria-hidden="true"></i><p>Choose an image to see a preview.</p></div> }<div class="field mt-4"><label for="uploadBox">@(editing ? "Replace image" : "Upload image")</label><input type="file" name="files" id="uploadBox" accept="image/jpeg,image/png,image/webp" class="form-control" required="@(!editing)" aria-describedby="image-help" /><p class="field-hint" id="image-help">JPG, PNG or WebP. A clear product photo works best.@(editing ? " Leave empty to keep the current image." : "")</p></div></aside></div><div class="form-actions"><button type="submit" class="btn btn-primary">@(editing ? "Save changes" : "Create product")</button><a asp-action="Index" class="btn btn-secondary">Cancel</a></div></form>
@section Scripts { <partial name="_ValidationScriptsPartial" /><script>$(function () { $('.summernote').summernote({height:250,toolbar:[['style',['bold','italic','underline','clear']],['para',['ul','ol','paragraph']],['insert',['link']],['view',['codeview']]],callbacks:{onInit:function(){document.querySelector('.note-editable')?.setAttribute('aria-label','Full description editor');document.querySelector('.note-resizebar')?.removeAttribute('aria-label');}}}); });</script> }
