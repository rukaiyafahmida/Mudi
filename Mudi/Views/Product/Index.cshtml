@model IEnumerable<Mudi_Models.Product>
@{ ViewData["Title"] = "Products"; }
<div class="page-heading"><div><h1>Products</h1><p>Manage your catalogue, prices and available stock.</p></div><a asp-action="Upsert" class="btn btn-primary"><i class="fas fa-plus" aria-hidden="true"></i>Create product</a></div>
@if (Model.Any()) { <div class="table-wrap"><div class="table-caption"><span>@Model.Count() products</span><span>Prices in BDT</span></div><table class="table table-mobile"><thead><tr><th>Product</th><th>Price / unit</th><th>Stock</th><th class="text-right">Actions</th></tr></thead><tbody>@foreach (var product in Model) { <tr><td data-label="Product"><div class="product-cell"><img src="@Mudi_Utility.WC.ImagePath@product.Image" alt="" class="table-thumb" loading="lazy" /><div><strong>@product.Name</strong><small>@product.Category?.Name</small></div></div></td><td data-label="Price"><span class="price">৳ @product.Price.ToString("N2")</span><br /><small class="text-muted">/ @product.Unit</small></td><td data-label="Stock" class="stock-value">@product.Stock</td><td data-label="Actions"><div class="actions"><a asp-action="Upsert" asp-route-id="@product.Id" class="btn btn-secondary" aria-label="Edit @product.Name">Edit</a><a asp-action="Delete" asp-route-id="@product.Id" class="btn btn-outline-danger" aria-label="Delete @product.Name">Delete</a></div></td></tr> }</tbody></table></div> }
else { <div class="empty-state"><i class="fas fa-box" aria-hidden="true"></i><h2>Your catalogue starts here</h2><p>Add a product, its price and a photo to get started.</p><a asp-action="Upsert" class="btn btn-primary">Create product</a></div> }
