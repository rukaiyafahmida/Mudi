@model List<Mudi_Models.ViewModels.WishListVM>
@{ ViewData["Title"] = "Wish list"; }
<div class="page-heading"><div><h1>Your wish list</h1><p>Saved for your next shop.</p></div><a asp-controller="Home" asp-action="Index" class="btn btn-secondary">Browse products</a></div>
@if (Model.Any()) { <div class="table-wrap"><table class="table table-mobile"><thead><tr><th>Product</th><th>Unit price</th><th>Stock</th><th class="text-right">Actions</th></tr></thead><tbody>@foreach (var item in Model) { <tr><td data-label="Product">@item.ProductName</td><td data-label="Price" class="price">৳ @item.UnitPrice.ToString("N2")</td><td data-label="Stock"><span class="status-badge">@(item.Stock > 0 ? "In stock" : "Out of stock")</span></td><td data-label="Actions"><div class="actions"><a asp-controller="Home" asp-action="Details" asp-route-id="@item.ProductId" class="btn btn-secondary">View product</a><a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger" aria-label="Remove @item.ProductName from wish list">Remove</a></div></td></tr> }</tbody></table></div> }
else { <div class="empty-state"><i class="far fa-heart" aria-hidden="true"></i><h2>A place for your favourites</h2><p>Add products to your wish list from their details page.</p><a asp-controller="Home" asp-action="Index" class="btn btn-primary">Explore the shop</a></div> }
