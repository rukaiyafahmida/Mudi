@model Mudi_Models.ViewModels.DetailsVM
@using Mudi_Utility
@{ ViewData["Title"] = Model.Product.Name; }
<a class="back-link" asp-controller="Home" asp-action="Index"><i class="fas fa-arrow-left" aria-hidden="true"></i>Back to products</a>
<form method="post"><input asp-for="Product.Id" type="hidden" />
<div class="product-detail"><div class="detail-art"><img src="@WC.ImagePath@Model.Product.Image" alt="@Model.Product.Name" /></div><div class="detail-body"><h1>@Model.Product.Name</h1><span class="badge mb-3">@Model.Product.Category.Name</span><p class="rich-copy">@Model.Product.ShortDescription</p><div class="price detail-price">৳ @Model.Product.Price.ToString("N2") <small>/ @Model.Product.Unit</small></div><div class="rich-copy">@Html.Raw(Model.Product.Description)</div><p class="detail-stock">@(Model.Product.Stock > 0 ? $"{Model.Product.Stock} {Model.Product.Unit} available" : "Currently out of stock")</p>
@if (!Model.ExistsInCart && Model.Product.Stock > 0) { <div class="field"><label asp-for="Product.TempQty">Quantity</label><input asp-for="Product.TempQty" type="number" min="1" max="@Math.Min(100, Model.Product.Stock)" class="form-control" /><span asp-validation-for="Product.TempQty" class="text-danger"></span></div> }
<div class="actions">@if (Model.ExistsInCart) { <a asp-action="RemoveFromCart" asp-route-id="@Model.Product.Id" class="btn btn-secondary">Remove from cart</a> } else if (Model.Product.Stock > 0) { <button type="submit" asp-route-id="@Model.Product.Id" class="btn btn-primary"><i class="fas fa-shopping-basket" aria-hidden="true"></i>Add to cart</button> } else { <button type="button" class="btn btn-secondary" disabled>Out of stock</button> }
@if (Model.ExistsWish) { <button type="button" class="btn btn-secondary" disabled><i class="fas fa-heart" aria-hidden="true"></i>Saved to wish list</button> } else { <a class="btn btn-secondary" asp-controller="WishList" asp-action="Add" asp-route-id="@Model.Product.Id"><i class="far fa-heart" aria-hidden="true"></i>Add to wish list</a> }</div></div></div></form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
