@model Mudi_Models.ViewModels.ContactUsVM
@{ ViewData["Title"] = "Contact us"; }
<div class="contact-layout"><div class="contact-copy"><h1>Let’s talk.</h1><p>Have a question about your shop, or an idea to make Mudi better? Send us a message.</p><h2>Contact us</h2><p><a href="mailto:info@mudi.com">info@mudi.com</a></p><p>Dhaka, Bangladesh</p><a class="back-link" asp-action="AboutUs">Read our story <i class="fas fa-arrow-right" aria-hidden="true"></i></a></div><form method="post" class="panel"><h2>Send a message</h2><div asp-validation-summary="All" class="text-danger"></div><div class="field-grid"><div class="field"><label asp-for="ApplicationUser.FullName">Full name</label><input asp-for="ApplicationUser.FullName" autocomplete="name" required class="form-control" /><span asp-validation-for="ApplicationUser.FullName" class="text-danger"></span></div><div class="field"><label asp-for="ApplicationUser.PhoneNumber">Phone number</label><input asp-for="ApplicationUser.PhoneNumber" type="tel" autocomplete="tel" class="form-control" /><span asp-validation-for="ApplicationUser.PhoneNumber" class="text-danger"></span></div><div class="field full"><label asp-for="ApplicationUser.Email">Email address</label><input asp-for="ApplicationUser.Email" type="email" autocomplete="email" required class="form-control" /><span asp-validation-for="ApplicationUser.Email" class="text-danger"></span></div><div class="field full"><label asp-for="Subject">Subject</label><input asp-for="Subject" class="form-control" required /><span asp-validation-for="Subject" class="text-danger"></span></div><div class="field full"><label asp-for="Message">Message</label><textarea asp-for="Message" rows="5" class="form-control" required></textarea><span asp-validation-for="Message" class="text-danger"></span></div></div><div class="form-actions"><button type="submit" class="btn btn-primary">Send message <i class="fas fa-arrow-right" aria-hidden="true"></i></button></div></form></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
