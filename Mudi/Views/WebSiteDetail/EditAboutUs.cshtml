@model Mudi_Models.ViewModels.WebSiteDetailVM
@{ ViewData["Title"] = "Edit about us"; }
<div class="form-page"><a class="back-link" asp-action="Index"><i class="fas fa-arrow-left" aria-hidden="true"></i>Back to website details</a><div class="page-heading"><div><h1>Edit about us</h1><p>Update your store information.</p></div></div><form method="post" asp-action="EditAboutUsPost" class="panel"><input asp-for="WebSiteDetailId" type="hidden" /><div asp-validation-summary="All" class="text-danger"></div><div class="field"><label asp-for="AboutUs">About us content</label><textarea asp-for="AboutUs" rows="10" class="form-control"></textarea><span asp-validation-for="AboutUs" class="text-danger"></span></div><div class="form-actions"><button type="submit" class="btn btn-primary">Save changes</button><a asp-action="Index" class="btn btn-secondary">Cancel</a></div></form></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
