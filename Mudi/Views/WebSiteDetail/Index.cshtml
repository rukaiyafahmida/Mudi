@model IEnumerable<Mudi_Models.WebSiteDetail>
@{ ViewData["Title"] = "Website details"; }
<div class="form-page"><div class="page-heading"><div><h1>Website details</h1><p>Maintain your store’s about and contact information.</p></div></div>@foreach (var item in Model) { <section class="website-section"><div class="section-heading"><h2>About us</h2><a class="btn btn-secondary" asp-action="EditAboutUs" asp-route-id="@item.Id">Edit about us</a></div><p class="website-copy">@item.AboutUs</p></section><section class="website-section"><div class="section-heading"><h2>Contact us</h2><a class="btn btn-secondary" asp-action="EditContactUs" asp-route-id="@item.Id">Edit contact us</a></div><p class="website-copy">@item.ContactUs</p></section> }</div>
