@model Mudi_Models.Category
@{ ViewData["Title"] = "Create category"; }
<div class="form-page"><a class="back-link" asp-action="Index"><i class="fas fa-arrow-left" aria-hidden="true"></i>Back to categories</a><div class="page-heading"><div><h1>Create category</h1><p>Give products a clear place in your shop.</p></div></div>
<form method="post" asp-action="Create" class="panel"><input asp-for="Id" type="hidden" /><div asp-validation-summary="All" class="text-danger"></div><div class="field-grid">
<div class="field full"><label asp-for="Name">Category name</label><input asp-for="Name" class="form-control" /><span asp-validation-for="Name" class="text-danger"></span></div>
<div class="field "><label asp-for="DisplayOrder">Display order</label><input asp-for="DisplayOrder" class="form-control" /><span asp-validation-for="DisplayOrder" class="text-danger"></span></div>
<div class="field full"><label asp-for="CategoryDescription">Description</label><textarea asp-for="CategoryDescription" class="form-control"></textarea><span asp-validation-for="CategoryDescription" class="text-danger"></span></div>
</div><div class="form-actions"><button type="submit" class="btn btn-primary">Create category</button><a asp-action="Index" class="btn btn-secondary">Cancel</a></div></form></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
