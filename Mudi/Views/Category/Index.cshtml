@model IEnumerable<Mudi_Models.Category>
@{ ViewData["Title"] = "Categories"; }
<div class="page-heading"><div><h1>Categories</h1><p>Arrange the shelves of your shop.</p></div><a asp-action="Create" class="btn btn-primary"><i class="fas fa-plus" aria-hidden="true"></i>Create category</a></div>
@if (Model.Any()) { <div class="table-wrap"><div class="table-caption"><span>@Model.Count() categories</span><span>Ordered by display position</span></div><table class="table table-mobile"><thead><tr><th>Category</th><th>Display order</th><th>Description</th><th class="text-right">Actions</th></tr></thead><tbody>@foreach (var category in Model.OrderBy(c => c.DisplayOrder)) { <tr><td data-label="Category"><strong>@category.Name</strong></td><td data-label="Position" class="stock-value">@category.DisplayOrder</td><td data-label="Description">@category.CategoryDescription</td><td data-label="Actions"><div class="actions"><a asp-action="Edit" asp-route-id="@category.Id" class="btn btn-secondary" aria-label="Edit @category.Name">Edit</a><a asp-action="Delete" asp-route-id="@category.Id" class="btn btn-outline-danger" aria-label="Delete @category.Name">Delete</a></div></td></tr> }</tbody></table></div> }
else { <div class="empty-state"><i class="fas fa-layer-group" aria-hidden="true"></i><h2>No categories yet</h2><p>Create a category to organise your products.</p><a class="btn btn-primary" asp-action="Create">Create category</a></div> }
