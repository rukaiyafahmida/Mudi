@model Mudi_Models.ViewModels.OrderListVM
@{ ViewData["Title"] = "Orders"; }
<div class="page-heading"><div><h1>Orders</h1><p>Find an order and move it through fulfilment.</p></div></div><form method="get" class="panel mb-4"><div class="filter-grid"><div class="field"><label for="searchName">Customer name</label><input id="searchName" name="searchName" value="@Context.Request.Query["searchName"]" class="form-control" /></div><div class="field"><label for="searchEmail">Email</label><input id="searchEmail" name="searchEmail" value="@Context.Request.Query["searchEmail"]" class="form-control" /></div><div class="field"><label for="searchPhone">Phone</label><input id="searchPhone" name="searchPhone" value="@Context.Request.Query["searchPhone"]" class="form-control" /></div><div class="field"><label asp-for="Status">Order status</label><select asp-for="Status" asp-items="Model.StatusList" class="form-control"><option value="">All statuses</option></select></div><div class="filter-actions"><a asp-action="Index" class="btn btn-secondary">Reset filters</a><button type="submit" class="btn btn-primary"><i class="fas fa-search" aria-hidden="true"></i>Search orders</button></div></div></form>
@if (Model.OrderHList.Any()) { <partial name="_OrderTable" model="Model.OrderHList" /> }
else { <div class="empty-state"><i class="fas fa-receipt" aria-hidden="true"></i><h2>No orders found</h2><p>New orders appear here. If you used filters, try a broader search.</p></div> }
