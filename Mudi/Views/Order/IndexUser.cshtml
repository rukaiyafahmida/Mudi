@model Mudi_Models.ViewModels.OrderListVM
@{ ViewData["Title"] = "Your orders"; }
<div class="page-heading"><div><h1>Your orders</h1><p>Your past shops and the status of your latest order.</p></div><a asp-controller="Home" asp-action="Index" class="btn btn-secondary">Back to shop</a></div>
@if (Model.OrderHList.Any()) { <partial name="_OrderTable" model="Model.OrderHList" /> }
else { <div class="empty-state"><i class="fas fa-receipt" aria-hidden="true"></i><h2>No orders yet</h2><p>Your orders will appear here after checkout.</p><a asp-controller="Home" asp-action="Index" class="btn btn-primary">Browse products</a></div> }
