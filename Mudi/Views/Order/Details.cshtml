@model Mudi_Models.ViewModels.OrderVM
@using Mudi_Utility
@{ ViewData["Title"] = $"Order #{Model.OrderHeader.Id}"; }
<a class="back-link" asp-action="Index"><i class="fas fa-arrow-left" aria-hidden="true"></i>Back to orders</a><div class="page-heading"><div><h1>Order #@Model.OrderHeader.Id</h1><p>Review the delivery information and update this order.</p></div></div><partial name="_OrderReceipt" model="Model" /><form method="post"><input asp-for="OrderHeader.Id" type="hidden" /><div class="form-actions">
@if (Model.OrderHeader.OrderStatus == WC.StatusPending) { <button type="submit" asp-action="StartProcessing" class="btn btn-primary">Start processing</button> }
@if (Model.OrderHeader.OrderStatus == WC.StatusInProcess) { <button type="submit" asp-action="ShipOrder" class="btn btn-primary">Ship order</button> }
@if (Model.OrderHeader.OrderStatus == WC.StatusShipped) { <button type="submit" asp-action="CompleteOrder" class="btn btn-primary">Complete order</button> }
@if (Model.OrderHeader.OrderStatus != WC.StatusCompleted && Model.OrderHeader.OrderStatus != WC.StatusCancelled) { <button type="submit" asp-action="CancelOrder" class="btn btn-outline-danger">Cancel order</button> }
</div></form>
