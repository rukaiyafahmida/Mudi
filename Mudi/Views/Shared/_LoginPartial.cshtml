@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@if (SignInManager.IsSignedIn(User))
{
    <a id="manage" class="account-link" asp-area="Identity" asp-page="/Account/Manage/Index"><i class="far fa-user" aria-hidden="true"></i>Manage profile</a>
    <form id="logoutForm" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
        <button id="logout" type="submit" class="btn btn-secondary w-100">Log out</button>
    </form>
}
else
{
    <p>Make your next shop yours.</p>
    <a class="btn btn-primary w-100" id="login" asp-area="Identity" asp-page="/Account/Login">Log in</a>
    <a class="account-link" id="register" asp-area="Identity" asp-page="/Account/Register">Create an account <i class="fas fa-arrow-right" aria-hidden="true"></i></a>
}
