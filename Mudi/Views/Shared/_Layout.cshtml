@using Microsoft.AspNetCore.Http
@using Mudi_Utility
@inject IHttpContextAccessor HttpContextAccessor
@{
    var admin = User.IsInRole(WC.AdminRole);
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var action = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    var page = ViewContext.RouteData.Values["page"]?.ToString() ?? "";
    var cartCount = HttpContextAccessor.HttpContext?.Session.Get<List<ShoppingCart>>(WC.SessionCart)?.Count ?? 0;
    string Active(string name) => controller == name ? "active" : "";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0b0e13" />
    <script>try{document.documentElement.dataset.theme=localStorage.getItem('mudi-theme')==='light'?'light':'dark';}catch{document.documentElement.dataset.theme='dark';}</script>
    <title>@(ViewData["Title"] ?? "Grocery shopping") · Mudi</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/fontawesome/css/all.css" />
    <link rel="stylesheet" href="~/lib/summernote/summernote-bs4.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="@(admin ? "admin-view" : "shop-view") @(page.Contains("/Manage/") ? "settings-view" : page.StartsWith("/Account/") ? "account-view" : "")">
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="mobile-header">
        <a class="brand" asp-area="" asp-controller="Home" asp-action="Index"><img src="~/images/basket.png" alt="" /><span>Mudi</span></a>
        <div class="mobile-tools"><button class="icon-button" type="button" data-theme-toggle aria-label="Switch colour theme"><i class="fas fa-adjust" aria-hidden="true"></i></button>
            @if (!admin) { <a class="icon-button" asp-area="" asp-controller="Cart" asp-action="Index" aria-label="Cart, @cartCount items"><i class="fas fa-shopping-basket" aria-hidden="true"></i><span class="count">@cartCount</span></a> }
            <button class="icon-button" id="menu-toggle" aria-expanded="false" aria-controls="site-navigation" aria-label="Open menu"><i class="fas fa-bars" aria-hidden="true"></i></button>
        </div>
    </header>
    <button class="nav-backdrop" type="button" aria-label="Close menu" tabindex="-1" hidden></button>
    <aside class="site-rail" id="site-navigation">
        <div class="rail-heading">
            <a class="brand" asp-area="" asp-controller="Home" asp-action="Index"><img src="~/images/basket.png" alt="" /><span>Mudi</span></a>
            <button class="icon-button rail-close" type="button" aria-label="Close menu"><i class="fas fa-times" aria-hidden="true"></i></button>
        </div>
        <nav class="primary-nav" aria-label="@(admin ? "Administration" : "Main navigation")">
            <a class="@(controller == "Home" && (action == "Index" || action == "Details") ? "active" : "")" asp-area="" asp-controller="Home" asp-action="Index"><i class="fas fa-th-large" aria-hidden="true"></i>@(admin ? "Overview" : "Shop")</a>
            @if (admin)
            {
                <a class="@Active("Product")" asp-area="" asp-controller="Product" asp-action="Index"><i class="fas fa-box" aria-hidden="true"></i>Products</a>
                <a class="@Active("Category")" asp-area="" asp-controller="Category" asp-action="Index"><i class="fas fa-layer-group" aria-hidden="true"></i>Categories</a>
                <a class="@Active("Order")" asp-area="" asp-controller="Order" asp-action="Index"><i class="fas fa-receipt" aria-hidden="true"></i>Orders</a>
                <a class="@Active("WebSiteDetail")" asp-area="" asp-controller="WebSiteDetail" asp-action="Index"><i class="fas fa-file-alt" aria-hidden="true"></i>Website details</a>
                <a asp-area="Identity" asp-page="/Account/Register"><i class="fas fa-user-plus" aria-hidden="true"></i>Create admin user</a>
            }
            else
            {
                <a class="@Active("Cart")" asp-area="" asp-controller="Cart" asp-action="Index"><i class="fas fa-shopping-basket" aria-hidden="true"></i>Cart <span class="nav-count">@cartCount</span></a>
                @if (User.IsInRole(WC.CustomerRole))
                {
                    <a class="@Active("WishList")" asp-area="" asp-controller="WishList" asp-action="Index"><i class="far fa-heart" aria-hidden="true"></i>Wish list</a>
                    <a class="@Active("Order")" asp-area="" asp-controller="Order" asp-action="IndexUser"><i class="fas fa-receipt" aria-hidden="true"></i>Your orders</a>
                }
            }
        </nav>
        <nav class="secondary-nav" aria-label="Information">
            <a asp-area="" asp-controller="Home" asp-action="AboutUs">About us</a>
            <a asp-area="" asp-controller="Home" asp-action="ContactUs">Contact us</a>
        </nav>
        <div class="rail-account"><button class="theme-switch btn btn-secondary w-100" type="button" data-theme-toggle><i class="fas fa-adjust" aria-hidden="true"></i><span data-theme-label>Light mode</span></button><partial name="_LoginPartial" /></div>
    </aside>
    <div class="app-body">
        <main id="main-content" class="main-content" tabindex="-1">
            <partial name="_Notifications" />
            @RenderBody()
        </main>
        <footer class="site-footer"><span>&copy; @DateTime.Now.Year Mudi</span><a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a><a asp-area="" asp-controller="Home" asp-action="ContactUs">Contact us</a></footer>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/sweetalert2/sweetalert2.all.min.js"></script>
    <script src="~/lib/summernote/summernote-bs4.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
