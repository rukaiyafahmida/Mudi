@model Mudi_Models.ViewModels.OrderVM
<div class="checkout-layout"><section class="panel"><div class="receipt-details"><div><h2>Delivery details</h2><p>@Model.OrderHeader.FullName</p><p>@Model.OrderHeader.StreetAddress</p><p>@Model.OrderHeader.City, @Model.OrderHeader.PostalCode</p><p>@Model.OrderHeader.PhoneNumber</p><p>@Model.OrderHeader.Email</p></div><div><h2>Order details</h2><dl><dt>Order date</dt><dd>@Model.OrderHeader.OrderDate.ToString("dd MMM yyyy")</dd><dt>Shipping date</dt><dd>@(Model.OrderHeader.ShippingDate == DateTime.MinValue ? "Not shipped yet" : Model.OrderHeader.ShippingDate.ToString("dd MMM yyyy"))</dd><dt>Status</dt><dd><span class="status-badge">@Model.OrderHeader.OrderStatus</span></dd></dl></div></div></section><aside class="summary-panel"><h2>Order summary</h2>@foreach (var item in Model.OrderDetail) { <div class="summary-item"><div><strong>@item.Product.Name</strong><small>@item.Qty × ৳ @item.PricePerUnit.ToString("N2")</small></div><span class="money">৳ @((item.Qty * item.PricePerUnit).ToString("N2"))</span></div> }<div class="summary-total"><span>Total (BDT)</span><span class="money">৳ @Model.OrderHeader.FinalOrderTotal.ToString("N2")</span></div></aside></div>
