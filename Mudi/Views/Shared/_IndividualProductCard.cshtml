@model Mudi_Models.Product
<article class="product-tile" data-category="@Model.CategoryId" data-search="@Model.Name @Model.Category.Name @Model.ShortDescription">
    <a class="product-art" asp-controller="Home" asp-action="Details" asp-route-id="@Model.Id" aria-label="View @Model.Name"><img src="@Mudi_Utility.WC.ImagePath@Model.Image" alt="@Model.Name" loading="lazy" width="280" height="350" /><div class="product-disclosure">@Model.ShortDescription<span>View details <i class="fas fa-arrow-right" aria-hidden="true"></i></span></div></a>
    <div class="product-meta"><h3><a asp-controller="Home" asp-action="Details" asp-route-id="@Model.Id">@Model.Name</a></h3><div class="price">৳ @Model.Price.ToString("N2") <span class="unit">/ @Model.Unit</span></div><p class="stock">@(Model.Stock > 0 ? "In stock" : "Out of stock")</p></div>
</article>
