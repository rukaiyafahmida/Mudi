@model IEnumerable<Mudi_Models.OrderHeader>
@using Mudi_Utility
<div class="table-wrap"><table class="table table-mobile"><thead><tr><th>Order</th><th>Customer</th><th>Total (BDT)</th><th>Status</th><th>Order date</th><th class="text-right">Actions</th></tr></thead><tbody>@foreach (var order in Model.OrderByDescending(o => o.OrderDate)) { <tr><td data-label="Order">#@order.Id</td><td data-label="Customer">@order.FullName</td><td data-label="Total" class="price">৳ @order.FinalOrderTotal.ToString("N2")</td><td data-label="Status"><span class="status-badge">@order.OrderStatus</span></td><td data-label="Date">@order.OrderDate.ToString("dd MMM yyyy")</td><td data-label="Actions"><div class="actions"><a asp-controller="Order" asp-action="@(User.IsInRole(WC.AdminRole) ? "Details" : "DetailsUser")" asp-route-id="@order.Id" class="btn btn-secondary" aria-label="View order @order.Id">View order</a></div></td></tr> }</tbody></table></div>
