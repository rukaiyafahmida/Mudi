@page
@model RegisterModel
@using Mudi_Utility
@{ var admin = User.IsInRole(WC.AdminRole); ViewData["Title"] = admin ? "Create admin account" : "Create account"; }
<div class="auth-layout"><div class="auth-intro"><h1>@(admin ? "Give your team access." : "A shop of your own.")</h1><p>@(admin ? "Create an administrator account to manage products, categories and orders." : "Save your favourites, build your cart and keep track of every order.")</p></div><section class="auth-form"><h2>@(admin ? "Create admin account" : "Create an account")</h2><form asp-route-returnUrl="@Model.ReturnUrl" method="post"><div asp-validation-summary="All" class="text-danger"></div>
<div class="form-group"><label asp-for="Input.FullName">Full name</label><input asp-for="Input.FullName" type="text" autocomplete="name" class="form-control" /><span asp-validation-for="Input.FullName" class="text-danger"></span></div>
<div class="form-group"><label asp-for="Input.Email">Email address</label><input asp-for="Input.Email" type="email" autocomplete="email" class="form-control" /><span asp-validation-for="Input.Email" class="text-danger"></span></div>
<div class="form-group"><label asp-for="Input.PhoneNumber">Phone number</label><input asp-for="Input.PhoneNumber" type="tel" autocomplete="tel" class="form-control" /><span asp-validation-for="Input.PhoneNumber" class="text-danger"></span></div>
<div class="form-group"><label asp-for="Input.Password">Password</label><input asp-for="Input.Password" type="password" autocomplete="new-password" class="form-control" /><span asp-validation-for="Input.Password" class="text-danger"></span></div>
<div class="form-group"><label asp-for="Input.ConfirmPassword">Confirm password</label><input asp-for="Input.ConfirmPassword" type="password" autocomplete="new-password" class="form-control" /><span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span></div>

<button type="submit" class="btn btn-primary">@(admin ? "Create admin account" : "Create account")</button></form>@if (!admin) { <div class="auth-links"><a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl">Already have an account? Log in</a></div> }
@if (!admin && Model.ExternalLogins?.Count > 0) { <div class="auth-external"><h3>Or continue with</h3><form id="external-account" asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post">@foreach (var provider in Model.ExternalLogins) { <button type="submit" class="btn btn-secondary" name="provider" value="@provider.Name">@provider.DisplayName</button> }</form></div> }</section></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
