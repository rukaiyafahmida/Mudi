@page
@model LoginModel
@{ ViewData["Title"] = "Log in"; }
<div class="auth-layout"><div class="auth-intro"><h1>Your shop. Your account.</h1><p>Keep your wish list, review your orders and pick up where you left off.</p><a class="back-link" asp-area="" asp-controller="Home" asp-action="Index"><i class="fas fa-arrow-left" aria-hidden="true"></i>Back to Mudi</a></div><section class="auth-form"><h2>Welcome back</h2><form id="account" method="post"><div asp-validation-summary="All" class="text-danger"></div><div class="form-group"><label asp-for="Input.Email">Email address</label><input asp-for="Input.Email" type="email" autocomplete="username" class="form-control" /><span asp-validation-for="Input.Email" class="text-danger"></span></div><div class="form-group"><label asp-for="Input.Password">Password</label><input asp-for="Input.Password" type="password" autocomplete="current-password" class="form-control" /><span asp-validation-for="Input.Password" class="text-danger"></span></div><div class="form-group checkbox"><label asp-for="Input.RememberMe"><input asp-for="Input.RememberMe" />Keep me signed in</label></div><button type="submit" class="btn btn-primary">Log in <i class="fas fa-arrow-right" aria-hidden="true"></i></button><div class="auth-links"><a id="forgot-password" asp-page="./ForgotPassword">Forgot your password?</a><a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">Create an account</a><a asp-page="./ResendEmailConfirmation">Resend email confirmation</a></div></form>
@if (Model.ExternalLogins?.Count > 0) { <div class="auth-external"><h3>Or continue with</h3><form id="external-account" asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post">@foreach (var provider in Model.ExternalLogins) { <button type="submit" class="btn btn-secondary" name="provider" value="@provider.Name">@provider.DisplayName</button> }</form></div> }</section></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
