  "components": [
    {
      "name": "Primary action",
      "kind": "button",
      "description": "Accent fill with theme-aware text, hover and keyboard focus.",
      "html": "<button class=\"ds-primary\" type=\"button\">Add to cart</button>",
      "css": ".ds-primary{font-family:Inter,sans-serif;font-size:13px;font-weight:600;line-height:1.5;display:inline-flex;align-items:center;justify-content:center;gap:9px;min-height:44px;padding:10px 18px;border:1px solid;border-radius:5px;text-decoration:none;transition:background-color .16s ease-out,border-color .16s ease-out,color .16s ease-out;background:var(--accent,#ffca64);border-color:var(--accent,#ffca64);color:var(--ground,#0b0e13);}.ds-primary:hover,.ds-primary:focus{background:#ffdb91;border-color:#ffdb91;color:var(--ground,#0b0e13);}.ds-primary:focus-visible{outline:2px solid var(--accent,#ffca64);outline-offset:4px;}:host-context([data-theme=\"light\"]) .ds-primary{color:var(--surface,#fffefa);}:host-context([data-theme=\"light\"]) .ds-primary:hover,:host-context([data-theme=\"light\"]) .ds-primary:focus{background:#754500;border-color:#754500;color:#fffefa;}",
      "refersTo": "button-primary"
    },
    {
      "name": "Secondary action",
      "kind": "button",
      "description": "A restrained bordered alternative for working actions.",
      "html": "<button class=\"ds-secondary\" type=\"button\">Manage products</button>",
      "css": ".ds-secondary{font-family:Inter,sans-serif;font-size:13px;font-weight:600;line-height:1.5;display:inline-flex;align-items:center;justify-content:center;gap:9px;min-height:44px;padding:10px 18px;border:1px solid;border-radius:5px;text-decoration:none;transition:background-color .16s ease-out,border-color .16s ease-out,color .16s ease-out;background:transparent;border-color:var(--line,#363d48);color:var(--ink,#eeeef0);}.ds-secondary:hover{background:var(--raised,#1f2530);border-color:var(--muted,#aab2be);color:var(--ink,#eeeef0);}.ds-secondary:focus-visible{outline:2px solid var(--accent,#ffca64);outline-offset:4px;}",
      "refersTo": "button-secondary"
    },
    {
      "name": "Destructive action",
      "kind": "button",
      "description": "Danger semantics for deletion without a solid competing accent.",
      "html": "<button class=\"ds-danger\" type=\"button\">Delete</button>",
      "css": ".ds-danger{font-family:Inter,sans-serif;font-size:13px;font-weight:600;line-height:1.5;display:inline-flex;align-items:center;justify-content:center;gap:9px;min-height:44px;padding:10px 18px;border:1px solid;border-radius:5px;text-decoration:none;transition:background-color .16s ease-out,border-color .16s ease-out,color .16s ease-out;background:#ffa2a810;border-color:#ffa2a85c;color:var(--danger,#ffa2a8);}.ds-danger:hover{background:#ffa2a822;border-color:var(--danger,#ffa2a8);}.ds-danger:focus-visible{outline:2px solid var(--accent,#ffca64);outline-offset:4px;}:host-context([data-theme=\"light\"]) .ds-danger{background:#ad253807;border-color:#ad25384d;}:host-context([data-theme=\"light\"]) .ds-danger:hover{background:#ad253814;}",
      "refersTo": "button-danger"
    },
    {
      "name": "Labelled field",
      "kind": "input",
      "description": "Visible label, grounded input and supporting hint.",
      "html": "<div class=\"ds-field\"><label for=\"ds-quantity\">Quantity</label><input id=\"ds-quantity\" type=\"number\" min=\"1\" value=\"1\" /><p>Choose the number of units.</p></div>",
      "css": ".ds-field{font-family:Inter,sans-serif;color:var(--ink,#eeeef0);max-width:320px;}.ds-field label{display:block;font-size:13px;font-weight:500;margin-bottom:8px;}.ds-field input{width:100%;min-height:46px;border:1px solid var(--line,#363d48);border-radius:5px;background:var(--ground,#0b0e13);color:var(--ink,#eeeef0);padding:10px 12px;font:15px/1.6 Inter,sans-serif;caret-color:var(--accent,#ffca64);}.ds-field input:focus{border-color:var(--accent,#ffca64);}.ds-field input:disabled,.ds-field input[readonly]{background:var(--raised,#1f2530);color:var(--muted,#aab2be);}.ds-field p{color:var(--muted,#aab2be);font-size:12px;margin:8px 0 0;}.ds-field input:focus-visible{outline:2px solid var(--accent,#ffca64);outline-offset:4px;}",
      "refersTo": "field"
    },
    {
      "name": "Task navigation",
      "kind": "nav",
      "description": "Text destinations with muted defaults and accent selection.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Administration\"><a class=\"ds-active\" href=\"#products\">Products</a><a href=\"#categories\">Categories</a><a href=\"#orders\">Orders</a></nav>",
      "css": ".ds-nav{display:grid;gap:6px;font-family:Inter,sans-serif;max-width:232px;}.ds-nav a{display:flex;align-items:center;min-height:48px;color:var(--muted,#aab2be);padding:10px 14px;border:1px solid transparent;border-radius:6px;font-size:14px;text-decoration:none;transition:background-color .16s ease-out,border-color .16s ease-out,color .16s ease-out;}.ds-nav a:hover{color:var(--ink,#eeeef0);background:var(--surface,#151921);}.ds-nav a.ds-active{border-color:var(--accent,#ffca64);color:var(--accent,#ffca64);background:#ffca6408;}.ds-nav a:focus-visible{outline:2px solid var(--accent,#ffca64);outline-offset:4px;}:host-context([data-theme=\"light\"]) .ds-nav a.ds-active{background:#9256000a;}"
    },
    {
      "name": "Category filter",
      "kind": "chip",
      "description": "Pressed category uses an amber border while preserving its label.",
      "html": "<button class=\"ds-category\" type=\"button\" aria-pressed=\"true\">All products</button>",
      "css": ".ds-category{font:13px/1.6 Inter,sans-serif;border:1px solid var(--line,#363d48);padding:10px 18px;background:transparent;border-radius:5px;color:var(--muted,#aab2be);min-height:44px;transition:background-color .16s ease-out,border-color .16s ease-out,color .16s ease-out;}.ds-category:hover{background:var(--surface,#151921);color:var(--ink,#eeeef0);}.ds-category[aria-pressed=true]{color:var(--accent,#ffca64);border-color:var(--accent,#ffca64);}.ds-category:focus-visible{outline:2px solid var(--accent,#ffca64);outline-offset:4px;}"
    },
    {
      "name": "Category badge",
      "kind": "chip",
      "description": "Compact non-interactive metadata on a raised tone.",
      "html": "<span class=\"ds-badge\">Rice &amp; grains</span>",
      "css": ".ds-badge{display:inline-flex;align-items:center;font:500 12px/1.6 Inter,sans-serif;padding:5px 10px;border:1px solid var(--line,#363d48);border-radius:4px;background:var(--raised,#1f2530);color:var(--ink,#eeeef0);white-space:normal;}",
      "refersTo": "badge"
