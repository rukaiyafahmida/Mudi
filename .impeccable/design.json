    {
      "name": "Form panel",
      "kind": "card",
      "description": "A flat bordered grouping used for editing and authentication.",
      "html": "<section class=\"ds-panel\"><h2>Contact details</h2><p>Keep your account information up to date.</p></section>",
      "css": ".ds-panel{border:1px solid var(--line,#363d48);border-radius:8px;background:var(--surface,#151921);color:var(--ink,#eeeef0);padding:28px;}.ds-panel h2{font:400 32px/1.13 Bebas,sans-serif;letter-spacing:.012em;margin:0 0 24px;}.ds-panel p{font:15px/1.6 Inter,sans-serif;color:var(--muted,#aab2be);margin:0 0 16px;}@media(max-width:640px){.ds-panel{padding:20px;}}@media(max-width:360px){.ds-panel{padding:16px;}}",
      "refersTo": "panel"
    },
    {
      "name": "Administration ledger",
      "kind": "custom",
      "description": "A ruled task row with count and management action; illustrative count is sample data.",
      "html": "<section class=\"ds-ledger\"><div class=\"ds-ledger-row\"><div><h2>Products</h2><p>Keep prices, images and stock up to date.</p></div><span class=\"ds-ledger-count\">16</span><a class=\"ds-ledger-action\" href=\"#products\">Manage products</a></div></section>",
      "css": ".ds-ledger{border-top:1px solid var(--line,#363d48);color:var(--ink,#eeeef0);}.ds-ledger-row{display:grid;grid-template-columns:1fr auto auto;gap:36px;align-items:center;border-bottom:1px solid var(--line,#363d48);padding:24px 0;}.ds-ledger h2{margin:0 0 5px;font:400 28px/1.13 Bebas,sans-serif;letter-spacing:.012em;}.ds-ledger p{margin:0;color:var(--muted,#aab2be);font:13px/1.6 Inter,sans-serif;}.ds-ledger-count{font:400 44px/1 Bebas,sans-serif;min-width:60px;text-align:right;font-variant-numeric:tabular-nums;}.ds-ledger-action{font-family:Inter,sans-serif;font-size:13px;font-weight:600;line-height:1.5;display:inline-flex;align-items:center;justify-content:center;gap:9px;min-height:44px;padding:10px 18px;border:1px solid;border-radius:5px;text-decoration:none;transition:background-color .16s ease-out,border-color .16s ease-out,color .16s ease-out;background:transparent;border-color:var(--line,#363d48);color:var(--ink,#eeeef0);}.ds-ledger-action:hover{background:var(--raised,#1f2530);border-color:var(--muted,#aab2be);}.ds-ledger-action:focus-visible{outline:2px solid var(--accent,#ffca64);outline-offset:4px;}@media(max-width:640px){.ds-ledger-row{grid-template-columns:1fr auto;gap:16px;padding:20px 0;}.ds-ledger-action{grid-column:1/-1;justify-self:start;}.ds-ledger h2{font-size:26px;}.ds-ledger-count{font-size:40px;}}"
    }
  ],
  "narrative": {
    "northStar": "Catalogue shelves",
    "overview": "Mudi combines browsable grocery artwork with clear working records. Condensed headings provide character; neutral body text, visible labels and ruled surfaces keep shopping, ordering and administration readable. The Mudi name and existing basket mark remain the identity.\n\nDark mode uses ink surfaces and pale amber. Light mode uses warm paper and deep amber, with the same information hierarchy and controls. Catalogue composition belongs to the [shared-interface surface brief](.impeccable/surfaces/mudi-views-shared-layout-cshtml.md); other routes use the layout their task needs.",
    "keyCharacteristics": [
      "Condensed display lettering paired with neutral, readable forms.",
      "Semantic light and dark themes shared by customer, admin and Identity pages.",
      "Restrained borders, small corners and tonal surfaces.",
      "Product facts and administrative actions remain available on small screens."
    ],
    "rules": [
      {
        "name": "The Theme Pair Rule",
        "body": "Use the active semantic ground, surface, raised, line, ink, muted and accent roles together. A theme change changes the palette, not the hierarchy.",
        "section": "colors"
      },
      {
        "name": "The Reading Voice Rule",
        "body": "Use Bebas Neue for large headings and Inter for product names, prices, form labels and working records. Keep commercial facts in the readable body voice.",
        "section": "typography"
      },
      {
        "name": "The Local Lift Rule",
        "body": "Keep resting forms and ledgers flat. Reserve the soft shadow for the engaged product artwork.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do use the active theme roles for every customer, admin and account surface.",
      "Do keep product name, price, unit and stock visible while supporting artwork copy is disclosed.",
      "Do retain visible form labels, keyboard focus, table cell labels and accessible names on icon controls.",
      "Do use ruled records and task-specific grids where they help administration, checkout or account work.",
      "Do preserve the selected Bebas Neue and Inter pairing and the existing factual product content.",
      "Do preserve state and information when reduced motion removes animation."
    ],
    "donts": [
      "Don't reduce the opacity of neighbouring shelf text or its ancestor containers; only artwork is attenuated.",
      "Don't hide essential product facts or primary actions behind hover-only disclosure.",
      "Don't turn the catalogue's title-card arrangement into a mandatory composition for every route.",
      "Don't use shadows as the default treatment for buttons, forms or administrative records.",
      "Don't present demo stock, prices or catalogue counts as production claims."
    ]
  }
}
