<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.12" />
    <!-- Use the OS SQLite library on Linux to support this machine's glibc 2.31. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite.Core" Version="10.0.12" />
    <PackageReference Include="SQLitePCLRaw.bundle_sqlite3" Version="2.1.11" Condition="$([MSBuild]::IsOSPlatform('Linux'))" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.12" Condition="!$([MSBuild]::IsOSPlatform('Linux'))" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Mudi_Model/Mudi_Models.csproj" />
    <ProjectReference Include="../Mudi_Utility/Mudi_Utility.csproj" />
  </ItemGroup>
</Project>
